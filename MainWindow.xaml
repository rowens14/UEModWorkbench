<Window x:Class="IrrModWorkbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:IrrModWorkbench.Models"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="IRR Mod Workbench" Height="Auto"  Width="Auto"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="0,0,0,-6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="2.5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Tool bar at the top of the GUI-->
        <Border Grid.Row="0" Grid.ColumnSpan="5" Background="{StaticResource WindowBackgroundBrush}" BorderBrush="{DynamicResource WindowBackgroundBrush}" BorderThickness="0,0,0,2.5" Padding="8,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="NewProjectButton" Content="New Project" Margin="4,0" Padding="8,4" Command="{Binding NewProjectCommand}"/>
                <Button x:Name="OpenProjectButton" Content="Open Project" Margin="4,0" Padding="8,4" Command="{Binding OpenProjectCommand}"/>
                <Button x:Name="CloseProjectButton" Content="Close Project" Margin="4,0" Padding="8,4" Command="{Binding CloseProjectCommand}"/>                
                <Button x:Name="OpenAssetButton" Content="Open Individual Asset" Margin="4,0" Padding="8,4" Command="{Binding OpenAssetCommand}"/>
                <Button x:Name="SaveAssetButton" Content="Save Changes to Asset" Margin="4,0" Padding="8,4" Command="{Binding SaveAssetCommand}"/>
                <Button x:Name="ExportAndBuildButton" Content="Pak &amp; Deploy Mod" Margin="4,0" Padding="8,4" Background="{DynamicResource AccentBrush}" Foreground="White" Command="{Binding ExportAndBuildCommand}"/>
                <Button x:Name="RolloverModsButton" Content="Rollover Mods" Margin="4,0" Padding="8,4" Command="{Binding RolloverModsCommand}"/>
            </StackPanel>
        </Border>

        <!-- Start of Left panel: Asset structure and Project Directory Panel -->
        <Border Grid.Row="1" Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>
                <!-- Top: Project directory tree -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Project" FontWeight="Bold" Margin="8,6,8,6" Foreground="{DynamicResource TextBrush}"/>

                    <TreeView x:Name="ProjectTree" Grid.Row="1" VerticalAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
                              MouseDoubleClick="ProjectTree_MouseDoubleClick"/>
                </Grid>
                <GridSplitter Grid.Row="1" Height="2.5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>
                <!-- Bottom: Asset Structure tree -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Asset Structure" FontWeight="Bold" Margin="8,6,8,6" Foreground="{DynamicResource TextBrush}"/>

                    <TreeView x:Name="AssetTree" Grid.Row="1" VerticalAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
                        <TreeView.Resources>
                            <DataTemplate DataType="{x:Type models:TreeNodeDisplay}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Type, StringFormat=' ({0})'}" Foreground="Gray" FontSize="11" Margin="4,0,0,0"/>
                                    <TextBlock Text="{Binding Preview, StringFormat=' = {0}'}" Foreground="DimGray" FontSize="11" Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Grid>
        </Border>
        <GridSplitter Grid.Row="1" Grid.Column="1"/>

        <!-- Center: Main Asset file browser + Details side by side -->
        <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource WindowBackgroundBrush}" Padding="2">
            <Grid>
                <!-- Asset Browser view (shown on launch) -->
                <Grid x:Name="AssetBrowserView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="4,4,4,2">
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="AssetSearchBoxFiles" Width="260" Margin="0,0,8,0" Text="{Binding AssetSearchText, UpdateSourceTrigger=PropertyChanged}" TextChanged="AssetFilesSearchBox_TextChanged"/>
                        <ComboBox x:Name="AssetTypeFilter" Width="120" SelectionChanged="AssetTypeFilter_SelectionChanged">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Project File Browser" FontSize="20" FontWeight="SemiBold" Margin="4,0" Padding="8,0"/>
                    <DataGrid x:Name="AssetList" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                      ItemsSource="{Binding FilteredBrowserItems}"
                              Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              SelectionMode="Single" Margin="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Relative Path" Binding="{Binding RelativePath}" Width="2*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Extension}" Width="70" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="80" />
                            <DataGridTextColumn Header="Modified" Binding="{Binding Modified, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <!-- JSON view (shown after opening a uasset) -->
                <Grid x:Name="JsonDetailsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tab strip for multiple open uassets -->
                    <ItemsControl x:Name="OpenTabsControl" Grid.Row="0" Margin="4,2,4,2">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:OpenAssetTab}">
                                <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="2,0" Padding="8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="Tab_MouseLeftButtonDown"/>
                                        <Button Content="×" Margin="6,0,0,0" Padding="2,0" FontSize="11" Tag="{Binding}" Click="TabCloseButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,4,4,2">
                        <TextBlock x:Name="CurrentAssetNameText" Text="" FontSize="16" FontWeight="SemiBold" Margin="4,0" Padding="8,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,2,4,2">
                        <Button x:Name="BackToBrowserButton" Content="Back to Asset Browser" Padding="6,2" Margin="6,0,0,0" Click="BackToBrowserButton_Click"/>

                    </StackPanel>
                    <avalon:TextEditor x:Name="JsonEditor" Grid.Row="3"
                                      FontFamily="Consolas" FontSize="11" Margin="2"
                                      ShowLineNumbers="True"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto" />
                </Grid>
                </Grid>
        </Border>



        <!-- Bottom: Terminal only -->
        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource TerminalBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,0">
            <Grid>
                <!-- Terminal -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="8,4">
                        <TextBlock Text="Terminal" FontWeight="Bold" Foreground="{DynamicResource TerminalTextBrush}" VerticalAlignment="Center"/>
                        <Button Content="Clear" Margin="12,0,0,0" Padding="6,2" Command="{Binding ClearTerminalCommand}"/>
                    </StackPanel>
                    <TextBox x:Name="TerminalBox" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource TerminalBackgroundBrush}" Foreground="{DynamicResource TerminalTextBrush}"
                              FontFamily="Consolas" FontSize="12" BorderThickness="0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Status bar -->
        <StatusBar Grid.Row="4" Background="{DynamicResource PanelBackgroundBrush}">
            <StatusBarItem>
                <TextBlock x:Name="StatusBarProject" Text="No project open"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusBarAsset" Text="No asset loaded" Margin="12,0,0,0"/>
            </StatusBarItem>
            <StatusBarItem>
                <ProgressBar x:Name="ImportProgress" Width="120" Height="14" IsIndeterminate="True" Visibility="Collapsed" Margin="12,0,0,0"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusBarUsmap" Text="No usmap selected" Margin="12,0,0,0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StatusBarCounts" Text=""/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>



