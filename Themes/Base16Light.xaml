<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgroundColor">#F8F8F8</Color>
    <Color x:Key="PanelBackgroundColor">#E8E8E8</Color>
    <Color x:Key="TextForegroundColor">#383838</Color>
    <Color x:Key="AccentColor">#7CAFC2</Color>
    <Color x:Key="BorderColor">#B8B8B8</Color>
    <Color x:Key="SelectionColor">#D8D8D8</Color>
    <Color x:Key="TerminalBackgroundColor">#F8F8F8</Color>
    <Color x:Key="TerminalForegroundColor">#383838</Color>
    <Color x:Key="SuccessColor">#A1B56C</Color>
    <Color x:Key="WarningColor">#F7CA88</Color>
    <Color x:Key="ErrorColor">#AB4642</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextForegroundColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="{StaticResource TerminalBackgroundColor}"/>
    <SolidColorBrush x:Key="TerminalTextBrush" Color="{StaticResource TerminalForegroundColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
</ResourceDictionary>